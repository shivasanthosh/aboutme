<!-- ============================================================ Journey ============================================================ -->
<div class="ide-window" id="experience">
    <div class="ide-titlebar">
        <div class="ide-dots">
            <span class="dot-red"></span><span class="dot-yellow"></span><span class="dot-green"></span>
        </div>
        <div class="ide-tabs">
            <span class="ide-tab active"><i class="fa fa-code-branch"></i> git log --graph</span>
        </div>
    </div>
    <div class="ide-body git-log">
        <div class="commit">
            <div class="commit-graph">
                <span class="commit-dot"></span>
                <span class="commit-line"></span>
            </div>
            <div class="commit-block">
                <div class="commit-meta">
                    <span class="commit-hash">a1e9f3c</span>
                    <span class="commit-branch">HEAD -&gt; main</span>
                    <span class="commit-date">Apr 2023 — Present</span>
                </div>
                <h3 class="commit-title">Senior Developer</h3>
                <p class="commit-org">Deloitte USI</p>
                <div class="commit-stats">
                    <div><span class="stat-value">3.5M+</span><span class="stat-label">resources scanned/day</span></div>
                    <div><span class="stat-value">243K+</span><span class="stat-label">issues auto-remediated</span></div>
                    <div><span class="stat-value">15+</span><span class="stat-label">Power BI reports shipped</span></div>
                    <div><span class="stat-value">10+</span><span class="stat-label">data sources unified</span></div>
                </div>
                <ul class="commit-body">
                    <li>Built an enterprise lakehouse on Microsoft Fabric/OneLake — <span class="stat-inline">10+ sources</span> normalized through a medallion architecture, feeding <span class="stat-inline">15+ Power BI</span> reports</li>
                    <li>Shipped an AI data assistant on top of it: MCP over Azure Functions plus an AWS Bedrock-backed Blazor chatbot for natural-language access to the gold layer</li>
                    <li>Engineered cloud resource scanning across <span class="stat-inline">3.5M+ resources</span> daily, with automated misconfiguration detection identifying and remediating <span class="stat-inline">243K+ issues</span>, delivering near real-time compliance visibility</li>
                    <li>Led migration of legacy platforms to managed Azure environments with IaC — <span class="stat-inline">40% faster</span> timeline, <span class="stat-inline">zero downtime</span></li>
                    <li>Developed a RESTful Exception Management API, automating exception workflows and cutting manual effort by <span class="stat-inline">60%</span></li>
                    <li>Built an advanced hybrid caching solution with resiliency features, delivering high-speed data access and fault tolerance across two enterprise projects</li>
                    <li>Designed audit log and event history modules using Azure Table Storage and event-driven patterns for real-time change tracking</li>
                    <li>Built secure file upload and automated analysis workflows, cutting cloud security assessment turnaround from <span class="stat-inline">5 days to 2 days</span></li>
                    <li>Configured Azure API Management to securely expose platform data, streamlining partner onboarding and boosting API adoption by <span class="stat-inline">25%</span></li>
                    <li>Established automated integration tests and CI/CD pipelines in .NET, reducing production defects by <span class="stat-inline">30%</span> and accelerating releases</li>
                    <li>Mentored peers and junior developers, fostering best practices in coding, architecture, and cloud adoption</li>
                </ul>
                <p class="commit-stack"><span class="key">stack:</span> .NET 9, CQRS, Azure, Fabric, PySpark, Terraform, Blazor, AWS Bedrock</p>
            </div>
        </div>
        <div class="commit">
            <div class="commit-graph">
                <span class="commit-dot"></span>
                <span class="commit-line"></span>
            </div>
            <div class="commit-block">
                <div class="commit-meta">
                    <span class="commit-hash">7c2b481</span>
                    <span class="commit-date">Dec 2019 — Apr 2023</span>
                </div>
                <h3 class="commit-title">Developer</h3>
                <p class="commit-org">Cognizant Technology Solutions</p>
                <ul class="commit-body">
                    <li>Modernized legacy systems by optimizing ASP.NET MVC apps with Razor and Entity Framework Core, improving performance by <span class="stat-inline">10%</span></li>
                    <li>Designed a high-performance Azure Function App to monitor on-prem SFTP/FTP servers and transfer files to Blob Storage, achieving <span class="stat-inline">2x faster</span> processing</li>
                    <li>Automated deployment pipelines for APIs across environments, integrating code scans and unit tests to improve quality and security</li>
                    <li>Reduced manual workload by <span class="stat-inline">50%</span> by automating fault reporting and migrating desktop applications into scalable web-based solutions</li>
                </ul>
                <p class="commit-stack"><span class="key">stack:</span> ASP.NET MVC, Azure, C#.NET, SQL Server</p>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ Projects ============================================================ -->
<div class="ide-window" id="projects">
    <div class="ide-titlebar">
        <div class="ide-dots">
            <span class="dot-red"></span><span class="dot-yellow"></span><span class="dot-green"></span>
        </div>
        <div class="ide-tabs">
            <span class="ide-tab active"><i class="fa fa-diagram-project"></i> projects</span>
        </div>
    </div>
    <div class="ide-body">
        <p class="section-intro"><span class="cm">// selected work — new projects get appended here as they ship</span></p>
        <div class="repo-grid">
            @foreach (var project in Projects)
            {
                <div class="repo-card @(project.Featured ? "featured" : "")">
                    <div class="repo-card-header">
                        <span class="repo-name"><i class="fa @project.Icon"></i>@project.Name</span>
                        @if (project.Org != null)
                        {
                            <span class="repo-badge">@project.Org</span>
                        }
                    </div>
                    <p class="repo-desc">@project.Description</p>
                    @if (project.Note != null)
                    {
                        <p class="repo-note">@project.Note</p>
                    }
                    @if (project.Url != null)
                    {
                        <a href="@project.Url.Value.Href" target="_blank" class="package-link">@project.Url.Value.Label →</a>
                    }
                    <div class="repo-tags">
                        @foreach (var tag in project.Tags)
                        {
                            <span class="tag">#@tag</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

