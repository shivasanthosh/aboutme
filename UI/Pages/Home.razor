<!-- ============================================================ Journey ============================================================ -->
<div class="ide-window" id="experience">
    <div class="ide-titlebar">
        <div class="ide-dots">
            <span class="dot-red"></span><span class="dot-yellow"></span><span class="dot-green"></span>
        </div>
        <div class="ide-tabs">
            <span class="ide-tab active"><i class="fa fa-code-branch"></i> git log --graph</span>
        </div>
    </div>
    <div class="ide-body git-log">
        <div class="commit">
            <div class="commit-graph">
                <span class="commit-dot"></span>
                <span class="commit-line"></span>
            </div>
            <div class="commit-block">
                <div class="commit-meta">
                    <span class="commit-hash">a1e9f3c</span>
                    <span class="commit-branch">HEAD -&gt; main</span>
                    <span class="commit-date">Apr 2023 — Present</span>
                </div>
                <h3 class="commit-title">Senior Developer</h3>
                <p class="commit-org">Deloitte USI</p>
                <ul class="commit-body">
                    <li>Built an enterprise data platform on Microsoft Fabric/OneLake — 10+ sources normalized through a medallion architecture, feeding 15+ Power BI reports</li>
                    <li>Shipped an AI data assistant: MCP over Azure Functions plus an AWS Bedrock-backed Blazor chatbot for querying the gold layer</li>
                    <li>Engineered cloud resource scanning across 3.5M+ resources</li>
                    <li>Led cloud migration with 40% faster timeline; reduced manual workload by 60% through automation</li>
                </ul>
                <p class="commit-stack"><span class="key">stack:</span> .NET 9, CQRS, Azure, Fabric, PySpark, Terraform, Blazor, AWS Bedrock</p>
            </div>
        </div>
        <div class="commit">
            <div class="commit-graph">
                <span class="commit-dot"></span>
                <span class="commit-line"></span>
            </div>
            <div class="commit-block">
                <div class="commit-meta">
                    <span class="commit-hash">7c2b481</span>
                    <span class="commit-date">Dec 2019 — Apr 2023</span>
                </div>
                <h3 class="commit-title">Developer</h3>
                <p class="commit-org">Cognizant Technology Solutions</p>
                <ul class="commit-body">
                    <li>Optimized ASP.NET MVC applications for a 10% performance gain</li>
                    <li>Designed high-performance Azure Functions for file monitoring and transfer</li>
                    <li>Automated deployment pipelines and improved code quality with comprehensive testing</li>
                </ul>
                <p class="commit-stack"><span class="key">stack:</span> ASP.NET MVC, Azure, C#.NET, SQL Server</p>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ Projects ============================================================ -->
<div class="ide-window" id="projects">
    <div class="ide-titlebar">
        <div class="ide-dots">
            <span class="dot-red"></span><span class="dot-yellow"></span><span class="dot-green"></span>
        </div>
        <div class="ide-tabs">
            <span class="ide-tab active"><i class="fa fa-diagram-project"></i> projects</span>
        </div>
    </div>
    <div class="ide-body">
        <p class="section-intro"><span class="cm">// selected work — new projects get appended here as they ship</span></p>
        <div class="repo-grid">
            @foreach (var project in Projects)
            {
                <div class="repo-card @(project.Featured ? "featured" : "")">
                    <div class="repo-card-header">
                        <span class="repo-name"><i class="fa @project.Icon"></i>@project.Name</span>
                        @if (project.Org != null)
                        {
                            <span class="repo-badge">@project.Org</span>
                        }
                    </div>
                    <p class="repo-desc">@project.Description</p>
                    @if (project.Note != null)
                    {
                        <p class="repo-note">@project.Note</p>
                    }
                    <div class="repo-tags">
                        @foreach (var tag in project.Tags)
                        {
                            <span class="tag">#@tag</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

