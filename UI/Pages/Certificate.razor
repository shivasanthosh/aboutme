@page "/certificate/{Id}"

<div class="ide-window">
    <div class="ide-titlebar">
        <div class="ide-dots">
            <span class="dot-red"></span><span class="dot-yellow"></span><span class="dot-green"></span>
        </div>
        <div class="ide-tabs">
            <span class="ide-tab active"><i class="fa fa-file-lines"></i> README.md</span>
        </div>
        <a href="" class="btn-ide" style="margin-left:auto;"><i class="fa fa-arrow-left"></i> back</a>
    </div>
    <div class="ide-body">
        <div class="package-cmd" style="margin-bottom:20px;">
            <span class="prompt">&gt;</span>dotnet add package @CertificateDetails.PackageId --version @CertificateDetails.Version
        </div>

        @if (!string.IsNullOrEmpty(CertificateDetails.ImageUrl))
        {
            <div class="text-center">
                <img src="@CertificateDetails.ImageUrl" alt="@CertificateDetails.Title" class="readme-image" />
            </div>
        }

        <h1 class="readme-title">@CertificateDetails.Title</h1>
        <p class="readme-subtitle">@CertificateDetails.Subtitle</p>

        @if (CertificateDetails.Description != null)
        {
            <p>@CertificateDetails.Description</p>
        }

        @if (CertificateDetails.Skills is { Length: > 0 } skills)
        {
            <p class="readme-section-label">## Features</p>
            <ul class="readme-features">
                @foreach (var skill in skills)
                {
                    <li>@skill</li>
                }
            </ul>
        }

        @if (CertificateDetails.CredlyUrl != null)
        {
            <p class="readme-section-label">## Verify</p>
            <div class="package-cmd">
                <span class="prompt">&gt;</span><a href="@CertificateDetails.CredlyUrl" target="_blank">dotnet nuget verify --signature</a>
            </div>
        }
    </div>
</div>
